# Created in Vercel Connect, then attached to this project/environment.
GITHUB_CONNECTOR=github/deepsec-scanner

# Required Vercel Connect Slack connector with the chat:write bot scope. Invite
# its managed Slack app to the destination channel; neither value is a credential.
SLACK_CONNECTOR=slack/deepsec-notifier
SLACK_CHANNEL_ID=

# Required revocable Vercel AI Gateway key. Set a project budget for this key.
# It is injected at the Sandbox firewall and never enters the microVM.
AI_GATEWAY_API_KEY=

# Required when any repository publishes GitHub issues. Used for unguessable
# issue deduplication markers.
# Generate independently, for example with: openssl rand -hex 32
DEEPSEC_MARKER_SECRET=

# Vercel Cron sends this automatically as `Authorization: Bearer ...`.
CRON_SECRET=

# Local development gets this short-lived identity from
# `vercel env pull .env.local`; do not set it manually.
VERCEL_OIDC_TOKEN=
